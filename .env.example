# Khel Shiksha — environment
# Copy to .env.local and fill in. Nothing here is required to run the site
# locally; each variable switches on a capability when present.

# ── Site ─────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap, OpenGraph and JSON-LD. Must be absolute.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salt for hashing IP addresses. Raw IPs are never stored — only
# SHA-256(ip + APP_SALT), which is enough for rate limiting without holding
# PII. Use a long random string; changing it resets all rate-limit buckets.
APP_SALT=""

# ── Database (Postgres) ──────────────────────────────────────────────────
# WITHOUT THIS, ENQUIRIES CANNOT BE STORED IN PRODUCTION. The form will tell
# visitors to phone instead rather than reporting a false success.
#
# Recommended: Neon (branch-per-PR) or Supabase. After setting these:
#   npx prisma migrate deploy     # production
#   npx prisma migrate dev        # local, creates the migration
DATABASE_URL=""
# Pooler-bypassing URL used by migrations only. Neon/Supabase both give you
# one. Omit for a plain local Postgres.
DIRECT_DATABASE_URL=""

# Escape hatch: write leads to .data/leads.jsonl instead of Postgres.
# Used by the E2E suite and usable on a staging box with no database.
# NEVER set this in production — a serverless filesystem is ephemeral.
# LEAD_STORE="file"

# ── Email (Resend) ───────────────────────────────────────────────────────
# Without these, lead notifications are logged instead of sent. Submissions
# still succeed and are still stored — notification is fire-and-forget.
RESEND_API_KEY=""
# Comma-separated. Where new enquiries are delivered.
LEAD_NOTIFY_TO=""
# Must be a domain verified in Resend.
LEAD_NOTIFY_FROM="enquiries@khelshiksha.com"

# ── Not yet wired ────────────────────────────────────────────────────────
# Sanity CMS — the content layer currently reads typed local files. When a
# project exists, services/cms swaps to GROQ with no call-site changes.
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET="production"
# SANITY_API_READ_TOKEN=""
# SANITY_WEBHOOK_SECRET=""

# ── AI assistant (Anthropic) ─────────────────────────────────────────────
# WITHOUT THIS THE ASSISTANT PANEL IS NOT RENDERED AT ALL — not rendered
# broken. A chat box that errors on every question is worse than no chat box.
#
# Cost note: this is a public endpoint on a lead-generation site, so it is
# metered per visitor question. The route caps history at 12 turns and the
# answer at 700 tokens, and rate limits to 12 questions/hour per hashed IP.
# Watch spend for the first week after launch.
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5. Set to claude-sonnet-5 or claude-haiku-4-5 to
# trade some answer quality for cost, without a code change.
# ANTHROPIC_MODEL="claude-opus-5"
